pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo "Building ${env.BRANCH_NAME}"
                sh 'mvn clean compile'
            }
        }

        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Deploy Dev') {
            when {
                branch 'dev'
            }
            steps {
                echo "Dev branch - test and scan only"
            }
        }

        stage('Deploy Production') {
            when {
                branch 'main'
            }
            steps {
                echo "Main branch deployment"

                input(
                    message: 'Deploy to Production?',
                    ok: 'Deploy'
                )

                sh '''
                echo "Production deployment started"
                '''
            }
        }
    }
}
